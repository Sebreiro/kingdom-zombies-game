<Project>
  <PropertyGroup>
    <DirectoryBuildPropsPath>$(MSBuildThisFileDirectory)../../src/godot-game/Directory.Build.props</DirectoryBuildPropsPath>
    <DirectoryBuildTargetsPath>$(MSBuildThisFileDirectory)../../src/godot-game/Directory.Build.targets</DirectoryBuildTargetsPath>
    <DirectoryPackagesPropsPath>$(MSBuildThisFileDirectory)../../src/godot-game/Directory.Packages.props</DirectoryPackagesPropsPath>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../../src/godot-game/NuGet.config</RestoreConfigFile>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Sebreiro.CodeRules.Analyzers</PackageId>
    <Description>Repository-owned Sebreiro code-rule analyzers; rule implementations arrive in plans 01-05 through 01-07.</Description>
    <Authors>Sebreiro</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
