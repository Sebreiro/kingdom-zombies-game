# Godot 4+ specific ignores
.godot/
/android/

# The regenerable workspace root: shared tools, downloads and NuGet caches, locks, runs and temp.
/.local/
# Legacy per-phase workspace folders, ignored until workspace-migrate.cjs retires them.
/.phase[0-9]*/
**/bin/
**/obj/
**/.godot/

# Derived GSD state and local workflow probes.
/.planning/state.json
/.planning/milestone.lock
/.planning/tmp/
