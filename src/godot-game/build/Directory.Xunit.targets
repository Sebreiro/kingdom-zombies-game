<Project>
  <!-- Keep the authentic pinned producer. Its package default hashes an absolute checkout path into the namespace. -->
  <PropertyGroup>
    <KzXunitPolicy>logical-project-seed-v1</KzXunitPolicy>
    <KzXunitLogicalSeed>KingdomZombies.Phase1.Tests/net10.0/xunit.v3.core.mtp-v2/4.0.2</KzXunitLogicalSeed>
    <_KzXunitPackage>$(NuGetPackageRoot)/xunit.v3.core.mtp-v2/4.0.2/</_KzXunitPackage>
  </PropertyGroup>
  <Target Name="KzVerifyXunitProducer" BeforeTargets="_XunitCreateEntryPointCache;CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'KingdomZombies.Phase1.Tests' Or '$(XunitAutoGeneratedEntryPoint)' != 'false'">
    <Error Code="KZXUNIT001" Text="XUNIT_POLICY: generated entry point must remain enabled"
           Condition="'$(XunitAutoGeneratedEntryPoint)' == 'false'" />
    <Error Code="KZXUNIT002" Text="XUNIT_POLICY: logical seed or policy changed"
           Condition="'$(KzXunitPolicy)' != 'logical-project-seed-v1' Or '$(KzXunitLogicalSeed)' != 'KingdomZombies.Phase1.Tests/net10.0/xunit.v3.core.mtp-v2/4.0.2'" />
    <Error Code="KZXUNIT003" Text="XUNIT_POLICY: expected net10.0 Core MSBuild producer"
           Condition="'$(TargetFramework)' != 'net10.0' Or '$(MSBuildRuntimeType)' != 'Core'" />
    <Error Code="KZXUNIT005" Text="XUNIT_POLICY: undeclared test project or root namespace"
           Condition="'$(MSBuildProjectName)' != 'KingdomZombies.Phase1.Tests' Or '$(RootNamespace)' != 'KingdomZombies.Phase1.Tests'" />
    <ItemGroup>
      <!-- Always verify the actual imported producer, even if an isolated negative supplies an extra probe. -->
      <_KzXunitProducer Include="$(NuGetPackageRoot)/xunit.v3.core.mtp-v2/4.0.2/xunit.v3.core.mtp-v2.4.0.2.nupkg">
        <ExpectedHash>784ED0C6555880636DC3DCF84B27559BCD27F150242C7EFF79E6A50D19913D72</ExpectedHash>
      </_KzXunitProducer>
      <_KzXunitProducer Include="$(NuGetPackageRoot)/xunit.v3.core.mtp-v2/4.0.2/buildTransitive/xunit.v3.core.mtp-v2.targets">
        <ExpectedHash>461321FD8C1E7DA66A8291ABDC80F95580F29AB2DB6BCD1582ED16B6EA915C19</ExpectedHash>
      </_KzXunitProducer>
      <_KzXunitProducer Include="$(NuGetPackageRoot)/xunit.v3.core.mtp-v2/4.0.2/_content/tasks/netcore/xunit.v3.msbuildtasks.dll">
        <ExpectedHash>A789901144674A050548B1198067CF5466552A2ED028A10AE629D9F8E369B2A3</ExpectedHash>
      </_KzXunitProducer>
      <_KzXunitProducer Include="$(_KzXunitPackage)xunit.v3.core.mtp-v2.4.0.2.nupkg">
        <ExpectedHash>784ED0C6555880636DC3DCF84B27559BCD27F150242C7EFF79E6A50D19913D72</ExpectedHash>
      </_KzXunitProducer>
      <_KzXunitProducer Include="$(_KzXunitPackage)buildTransitive/xunit.v3.core.mtp-v2.targets">
        <ExpectedHash>461321FD8C1E7DA66A8291ABDC80F95580F29AB2DB6BCD1582ED16B6EA915C19</ExpectedHash>
      </_KzXunitProducer>
      <_KzXunitProducer Include="$(_KzXunitPackage)_content/tasks/netcore/xunit.v3.msbuildtasks.dll">
        <ExpectedHash>A789901144674A050548B1198067CF5466552A2ED028A10AE629D9F8E369B2A3</ExpectedHash>
      </_KzXunitProducer>
    </ItemGroup>
    <GetFileHash Files="$(MSBuildThisFileFullPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="KzXunitOwnedPolicyHash" />
    </GetFileHash>
    <ItemGroup>
      <_XunitEntryPointCacheHashItems Include="$(KzXunitPolicy);$(KzXunitLogicalSeed);$(KzXunitOwnedPolicyHash)" />
    </ItemGroup>
    <GetFileHash Files="@(_KzXunitProducer)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_KzXunitProducerHashes" />
    </GetFileHash>
    <Error Code="KZXUNIT004" Text="XUNIT_PRODUCER_HASH: %(_KzXunitProducerHashes.Identity)"
           Condition="'%(_KzXunitProducerHashes.FileHash)' != '%(_KzXunitProducerHashes.ExpectedHash)'" />
  </Target>
  <!-- Imported after the package target; preserve its task, output, attachment and incremental cache protocol. -->
  <Target Name="_XunitGenerateEntryPoint" Inputs="@(XunitEntryPointCachePath)" Outputs="$(_XunitEntryPointPath)"
          Condition="'$(XunitAutoGeneratedEntryPoint)' != 'false'"
          DependsOnTargets="_XunitCreateEntryPointCache;KzVerifyXunitProducer">
    <XunitGenerateEntryPoint SourcePath="$(_XunitEntryPointPath)" RootNamespace="$(RootNamespace)"
                            SuffixSeed="$(KzXunitLogicalSeed)" Language="$(Language)"
                            UseMicrosoftTestingPlatformRunner="$(UseMicrosoftTestingPlatformRunner)" />
    <ItemGroup>
      <FileWrites Include="$(_XunitEntryPointPath)" />
    </ItemGroup>
  </Target>
  <Target Name="KzRecordXunitProducer" AfterTargets="_XunitGenerateEntryPoint"
          Condition="'$(MSBuildProjectName)' == 'KingdomZombies.Phase1.Tests'">
    <GetFileHash Files="$(_XunitEntryPointPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="KzXunitRawSourceHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)KzXunitProducer.receipt" Overwrite="true"
                      WriteOnlyWhenDifferent="true" Encoding="UTF-8"
                      Lines="Policy=$(KzXunitPolicy);Seed=$(KzXunitLogicalSeed);Project=$(MSBuildProjectFullPath);Source=$(_XunitEntryPointPath);RawSha256=$(KzXunitRawSourceHash);TaskSha256=A789901144674A050548B1198067CF5466552A2ED028A10AE629D9F8E369B2A3;PackageSha256=784ED0C6555880636DC3DCF84B27559BCD27F150242C7EFF79E6A50D19913D72;TargetsSha256=461321FD8C1E7DA66A8291ABDC80F95580F29AB2DB6BCD1582ED16B6EA915C19;Task=Xunit.v3.MSBuildTasks.XunitGenerateEntryPoint;Version=4.0.2;PolicySha256=$(KzXunitOwnedPolicyHash)" />
  </Target>
</Project>
