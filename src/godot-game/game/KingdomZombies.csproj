<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/KingdomZombies.Core.csproj" />
    <ProjectReference Include="../multiplayer-abstractions/KingdomZombies.Multiplayer.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'ExportDebug'">
    <Compile Remove="foundation/FoundationAutomation.cs;foundation/FoundationNativeRegression.cs" />
  </ItemGroup>
</Project>
