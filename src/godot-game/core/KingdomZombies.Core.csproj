<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KingdomZombies.Phase1.Tests" />
    <EmbeddedResource Include="../game/content/config/run.json;../game/content/config/survivors.json;../game/content/config/items.json;../game/content/config/inventory.json;../game/content/config/combat.json;../game/content/config/food-wildlife.json"
                      LogicalName="content/config/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
